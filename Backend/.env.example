# Copy this file to `.env` and replace the placeholder with your real connection string.
# Connection string for PostgreSQL.
# Requires PostgreSQL >= 15.

DATABASE_URL="postgresql://user:password@localhost:5432/mydb"
PORT=5000
# URL pública da aplicação, HTTPS obrigatório fora de localhost.
PUBLIC_BASE_URL=http://localhost:5000
# Gere uma chave de 32 bytes em hexadecimal (64 caracteres). Não troque enquanto houver campanhas ativas.
CAMPAIGN_ENCRYPTION_KEY=
# Segredo administrativo (32 bytes em base64url). Nunca colocar no frontend.
ADMIN_API_TOKEN=
UZAPI_BASE_URL=https://api.uzapi.com.br
UZAPI_VERSION=v1
# Fuso usado somente na apresentação das datas nas respostas JSON.
API_TIMEZONE=America/Sao_Paulo
# Padrão para novas instâncias. Instâncias existentes usam limiteDiarioContatos no banco.
DAILY_CONTACT_LIMIT=250

# SMTP PARA CONFIGURAÇÃO DE ENVIO DE EMAILS
SMTP_HOST=smtp.seuprovedor.com
SMTP_PORT=587
SMTP_SECURE=false

SMTP_USER=
SMTP_PASS=

SMTP_FROM=
